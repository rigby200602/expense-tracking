generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model budget {
  id      String  @id @db.Uuid
  month   Int?    @db.SmallInt
  year    Int?    @db.SmallInt
  amount  BigInt?
  user_id String? @db.Uuid
  users   users?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_user")
}

model categories {
  id           String         @id @db.Uuid
  name         String         @db.VarChar(50)
  type         String         @db.VarChar(20)
  color        String         @db.VarChar(30)
  icon         String         @db.VarChar(100)
  create_at    DateTime?      @default(now()) @db.Timestamp(6)
  user_id      String?        @db.Uuid
  users        users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_user")
  transactions transactions[]
}

model transactions {
  id          String           @id @db.Uuid
  amount      BigInt?
  note        String?
  date        DateTime?        @db.Date
  type        transaction_type
  create_at   DateTime?        @default(now()) @db.Timestamp(6)
  user_id     String?          @db.Uuid
  category_id String?          @db.Uuid
  categories  categories?      @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_transaction_category")
  users       users?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_user")
}

model users {
  id           String         @id @db.Uuid
  name         String         @db.VarChar(100)
  email        String?        @unique @db.VarChar(125)
  password     String         @db.VarChar(255)
  create_at    DateTime?      @default(now()) @db.Timestamp(6)
  update_at    DateTime?      @default(now()) @db.Timestamp(6)
  budget       budget[]
  categories   categories[]
  transactions transactions[]
}

enum transaction_type {
  income
  expense
}
